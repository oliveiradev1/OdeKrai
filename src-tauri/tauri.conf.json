{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OdeKrai",
  "version": "0.16.0",
  "identifier": "site.anceryx.odekrai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && npm run check:debug-command",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OdeKrai",
        "width": 1250,
        "height": 700,
        "minWidth": 1000,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "OdeKrai",
    "longDescription": "OdeKrai para Windows.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "nsis": {
        "installMode": "currentUser"
      },
      "signCommand": null,
      "timestampUrl": null,
      "tsp": false
    }
  }
}
